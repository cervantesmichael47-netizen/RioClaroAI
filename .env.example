# Configuración local. Nunca agregues secretos reales a este archivo.
NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=
RIOCLARO_DATA_FILE=
RIOCLARO_AUDIT_FILE=
FOUNDRY_CONVERSATIONS_FILE=

# Entorno público de evaluación: activar solo en una instancia independiente.
RIOCLARO_EVALUATION_MODE=false
RIOCLARO_EVALUATION_DATA_FILE=
RIOCLARO_EVALUATION_AUDIT_FILE=
RIOCLARO_EVALUATION_CONVERSATIONS_FILE=
RIOCLARO_OPERATIONAL_DATA_FILE=
RIOCLARO_OPERATIONAL_AUDIT_FILE=
RIOCLARO_OPERATIONAL_CONVERSATIONS_FILE=

# Microsoft Entra ID: registro del tenant/API y roles de aplicación.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_BRANCH_CLAIM=extension_branch
AZURE_CLIENT_ID=

# Key Vault para entorno Azure (identidad administrada); localmente usa env vars.
KEY_VAULT_URL=
KEY_VAULT_SECRET_NAMES=
# Solo desarrollo local; nunca configures este token en Azure ni lo publiques.
AZURE_KEY_VAULT_ACCESS_TOKEN=

# Microsoft Foundry: project endpoint HTTPS y agente existente.
FOUNDRY_PROJECT_ENDPOINT=https://rioclaroia-resource.services.ai.azure.com/api/projects/rioclaroia
FOUNDRY_AGENT_NAME=RioClaroAssistant
FOUNDRY_ENABLED=false
FOUNDRY_SUSPENDED=false
FOUNDRY_TIMEOUT_MS=20000

# OCR opcional mediante Azure AI Document Intelligence (identidad administrada).
DOCUMENT_INTELLIGENCE_ENDPOINT=

# Solo para validar localmente sin Entra. No se permite en producción.
ALLOW_UNAUTHENTICATED_LOCAL_CHAT=false
